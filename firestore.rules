rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is an authorized store admin or permanent owner
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'raghurl.2072@gmail.com' ||
          request.auth.token.email.lower() == 'raghurl.202@gmail.com'
        )) ||
        (
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.active == true
        )
      );
    }

    // Check if user is a registered and active delivery rider
    function isRider() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/riders/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.isActive == true
      );
    }

    // -------------------------------------------------------------
    // 1. Admins Collection
    // -------------------------------------------------------------
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 2. Settings Collection (appConfig, counters, store status)
    // -------------------------------------------------------------
    match /settings/{settingId} {
      // Consumers & Riders can read store open status, delivery fees, and catalogVersion
      allow read: if true;
      // Admins have write access; sequential order counter increment is allowed during transaction
      allow write: if isAdmin() || (settingId == 'counters' && isAuthenticated());
    }

    // -------------------------------------------------------------
    // 3. Sections Collection (Storefront Layout hierarchy)
    // -------------------------------------------------------------
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. Categories Collection (Blinkit-style Category Grid)
    // -------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. Products Collection (Catalog, 1-Click Stock, Shelves)
    // -------------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 6. Riders Collection (Fleet profiles, login credentials & ledger)
    // -------------------------------------------------------------
    match /riders/{riderId} {
      // Admins manage all riders, commissions, and payout records
      allow read, write: if isAdmin();
      // Riders can read/update their live status and location in the Rider App
      allow read, update: if isAuthenticated() && (request.auth.uid == riderId || isAdmin());
    }

    // -------------------------------------------------------------
    // 7. Analytics Collection (Daily reports & Global stats)
    // -------------------------------------------------------------
    match /analytics/{docId} {
      allow read: if isAdmin();
      // Allow write during order completion transaction
      allow write: if isAdmin() || isRider() || isAuthenticated();
    }

    // -------------------------------------------------------------
    // 8. Users Collection (Customer profiles & saved addresses)
    // -------------------------------------------------------------
    match /users/{userId} {
      allow create: if true;
      allow read, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) || true;
    }

    // -------------------------------------------------------------
    // 9. Orders Collection (Core Dispatch Pipeline)
    // -------------------------------------------------------------
    match /orders/{orderId} {
      // Customers can create orders with sequential G-xxxx numbers
      allow create: if true;

      // Real-time tracking:
      // - Admins can read all orders
      // - Assigned Rider can read and update their assigned orders (ready_to_deliver, handover, on_the_way, reached, delivered)
      // - Customer can track their own order by userId or orderId
      allow read: if true;
      allow update: if isAdmin() || isRider() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      ) || true;
      allow delete: if isAdmin();
    }

  }
}
